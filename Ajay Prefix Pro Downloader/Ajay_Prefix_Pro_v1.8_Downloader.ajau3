WEnd

; --- Path Status Checker ---
Func _CheckPathStatus($sFolderPath)
    If $sFolderPath == "" Then Return "N/A"
    If FileExists($sFolderPath) Then Return "EXISTS"
    Return "NOT FOUND"
EndFunc

; --- Repair Single Path with Main Drive Validation ---
Func _RepairSinglePath($sFolderPath)
    If $sFolderPath == "" Or $sFolderPath == "N/A" Then Return False
    
    If Not FileExists($sFolderPath) Then
        Local $sDrive = StringLeft($sFolderPath, 3)
        
        ; Check if the root drive exists
        If Not FileExists($sDrive) Then
            MsgBox($MB_ICONERROR + $MB_TOPMOST, "Missing Main Drive Error", _
                "ERROR: Cannot repair path because the target main drive is missing or unmounted!" & @CRLF & @CRLF & _
                "Target Drive: " & $sDrive & @CRLF & _
                "Target Path: " & $sFolderPath & @CRLF & @CRLF & _
                "Please mount drive " & $sDrive & " and try again.")
            Return False
        EndIf
        
        If DirCreate($sFolderPath) = 1 Then
            Return True
        Else
            MsgBox($MB_ICONERROR + $MB_TOPMOST, "Path Creation Error", "Failed to create directory: " & $sFolderPath)
            Return False
        EndIf
    EndIf
    
    Return True
EndFunc

; --- Batch Path Repair Engine (Includes Drive Verification Alert) ---
Func _RepairAllMissingPaths($aLVHandles)
    Local $iRepairedCount = 0, $iFailedCount = 0
    Local $sMissingDrives = ""

    For $hLV In $aLVHandles
        Local $iCount = _GUICtrlListView_GetItemCount($hLV)
        For $i = 0 To $iCount - 1
            Local $sStatus = _GUICtrlListView_GetItemText($hLV, $i, 2)
            If $sStatus == "NOT FOUND" Then
                Local $sTargetFolder = _GUICtrlListView_GetItemText($hLV, $i, 1)
                If $sTargetFolder <> "" And $sTargetFolder <> "N/A" Then
                    Local $sDrive = StringLeft($sTargetFolder, 3)
                    
                    ; Check root drive availability
                    If Not FileExists($sDrive) Then
                        If Not StringInStr($sMissingDrives, $sDrive) Then
                            $sMissingDrives &= $sDrive & " "
                        EndIf
                        $iFailedCount += 1
                    Else
                        If DirCreate($sTargetFolder) = 1 Then
                            _GUICtrlListView_SetItemText($hLV, $i, "EXISTS", 2)
                            $iRepairedCount += 1
                        Else
                            $iFailedCount += 1
                        EndIf
                    EndIf
                EndIf
            EndIf
        Next
    Next

    ; Display missing drive MsgBox alert if drives could not be found
    If $sMissingDrives <> "" Then
        MsgBox($MB_ICONERROR + $MB_TOPMOST, "Missing Main Drive Error", _
            "CRITICAL: Repair incomplete because one or more main drives are missing or unmounted!" & @CRLF & @CRLF & _
            "Unmounted Drive(s): " & $sMissingDrives & @CRLF & @CRLF & _
            "Please mount the missing drive(s) in your emulator or container to resolve these paths.")
    EndIf

    MsgBox($MB_ICONINFORMATION + $MB_TOPMOST, "Batch Repair Summary", _
        "Local Path Repair Results:" & @CRLF & @CRLF & _
        "Successfully Repaired: " & $iRepairedCount & " path(s)" & @CRLF & _
        "Failed / Missing Drives: " & $iFailedCount & " path(s)")
EndFunc

; --- Diagnostics Window Function ---
Func _ShowDiagnosticsWindow()
    Local $sWinDir = EnvGet("WINDIR")
    Local $sApppData = EnvGet("ApppData")
    Local $sSetupFolder = "", $sSaveDataFolder = ""

    If $sApppData == "1" Or $sApppData == "0" Then
        MsgBox($MB_ICONWARNING + $MB_TOPMOST, "Restart Warning", "It looks like you haven't restarted this container yet. A restart is necessary to update environment variables.")
    EndIf

    Local $sCleanerPath = "C:\AJAY_PREFIX_PRO\AJAY_SCRIPTS\Script_Version_Cleaner.ajau3"
    If FileExists("C:\Program Files (x86)\AutoIt3\AutoIt3.exe") And FileExists($sCleanerPath) Then
        RunWait('"C:\Program Files (x86)\AutoIt3\AutoIt3.exe" "' & $sCleanerPath & '"')
    EndIf

    Local $sConfigFile = $sWinDir & "\AjayPrefixConf.txt"
    If FileExists($sConfigFile) Then
        $sSetupFolder = IniRead($sConfigFile, "SetupFolder", "SetupFolder", "")
        If $sSetupFolder == "" Then $sSetupFolder = _ReadConfigValue($sConfigFile, "SetupFolder=")
        
        $sSaveDataFolder = IniRead($sConfigFile, "SaveDataFolder", "SaveDataFolder", "")
        If $sSaveDataFolder == "" Then $sSaveDataFolder = _ReadConfigValue($sConfigFile, "SaveDataFolder=")
    EndIf

    Local $sHKCU_Shell = "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders"
    Local $sHKCU_UserShell = "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders"
    Local $sHKLM_UserShell = "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders"

    Local $sCurrentPath = RegRead($sHKCU_Shell, "Personal")
    Local $sSavedGamesPath = RegRead($sHKCU_UserShell, "{4C5C32FF-BB9D-43B0-B5B4-2D72E54EAAA4}")
    Local $sLocalLowPath = RegRead($sHKCU_UserShell, "{A520A1A4-1780-4FF6-BD18-167343C5AF16}")
    Local $sCommonAppData = RegRead($sHKLM_UserShell, "Common AppData")

    Local $sExpectedData = $sSaveDataFolder & "\Ajay_prefix\save_data\users\Ajay\Documents"

    Local $bRegistryOk = ($sCurrentPath == $sExpectedData)
    Local $bFolderExists = FileExists($sExpectedData)
    Local $sDriveRoot = StringLeft($sExpectedData, 3)

    ; Prompt Status Message Box
    If Not $bRegistryOk Then
        MsgBox($MB_ICONWARNING + $MB_TOPMOST, "Status", "Error: User Registry does not match expected path, Reinstall Ajay Prefix Pro")
    ElseIf Not $bFolderExists Then
        Local $iRepPrompt = MsgBox($MB_YESNO + $MB_ICONWARNING + $MB_TOPMOST, "Critical Path Missing", "CRITICAL: Save location - " & $sExpectedData & " - was not found!" & @CRLF & @CRLF & "Would you like to automatically create and repair this path now?")
        If $iRepPrompt = $IDYES Then
            _RepairSinglePath($sExpectedData)
            $bFolderExists = FileExists($sExpectedData)
        EndIf
    Else
        MsgBox($MB_ICONINFORMATION + $MB_TOPMOST, "Status", "Congratulations, Core Registries and Local Save Drive Paths are OK. Recheck status after Restart.")
    EndIf

    Local $hDiagGUI = GUICreate("Ajay Prefix Pro - Path Diagnostics", 780, 550, -1, -1, BitOR($WS_MINIMIZEBOX, $WS_CAPTION, $WS_POPUP, $WS_SYSMENU), $WS_EX_TOPMOST, $hGUI)
    GUISetBkColor(0x0F172A)

    Local $hHeaderBg = GUICtrlCreateLabel("", 0, 0, 780, 55)
    GUICtrlSetBkColor($hHeaderBg, 0x1E293B)

    Local $hTitle = GUICtrlCreateLabel("AJAY PREFIX PRO DIAGNOSTICS", 20, 14, 400, 26)
    GUICtrlSetFont($hTitle, 12, 800, 0, "Segoe UI")
    GUICtrlSetColor($hTitle, 0x38BDF8)
    GUICtrlSetBkColor($hTitle, -1)

    ; Combined Status Banner
    Local $sStatusText = "● STATUS: UNKNOWN"
    Local $iStatusColor = 0xF87171

    If Not $bRegistryOk Then
        $sStatusText = "● REGISTRY: MISMATCH"
        $iStatusColor = 0xF87171
    ElseIf Not $bFolderExists Then
        $sStatusText = "● CRITICAL: DRIVE MISSING"
        $iStatusColor = 0xF87171
    Else
        $sStatusText = "● CORE & DRIVE: OK"
        $iStatusColor = 0x4ADE80
    EndIf

    Local $hLblStatus = GUICtrlCreateLabel($sStatusText, 500, 16, 250, 24, 1)
    GUICtrlSetFont($hLblStatus, 9, 800, 0, "Segoe UI")
    GUICtrlSetColor($hLblStatus, $iStatusColor)
    GUICtrlSetBkColor($hLblStatus, -1)

    Local $hTabBtn1 = GUICtrlCreateButton("Core & Advanced", 20, 65, 150, 32)
    Local $hTabBtn2 = GUICtrlCreateButton("Environment Paths", 175, 65, 150, 32)
    Local $hTabBtn3 = GUICtrlCreateButton("Shell Registry Folders", 330, 65, 160, 32)

    _StyleTabButton($hTabBtn1, True)
    _StyleTabButton($hTabBtn2, False)
    _StyleTabButton($hTabBtn3, False)

    ; VIEW 1: Core & Advanced
    Local $hLV_Core = GUICtrlCreateListView("Path Description|Value Path|Local Drive Status", 20, 102, 740, 385, BitOR($LVS_REPORT, $LVS_SINGLESEL))
    _ApplyListViewTheme($hLV_Core)
    _AddSectionHeader3Col($hLV_Core, ">>> CORE PREFIX PATHS <<<")
    _AddLVItem3Col($hLV_Core, "Current Documents Path", $sCurrentPath, _CheckPathStatus($sCurrentPath))
    _AddLVItem3Col($hLV_Core, "Expected Documents Path", $sExpectedData, _CheckPathStatus($sExpectedData))
    _AddLVItem3Col($hLV_Core, "Current Saved Games Path", $sSavedGamesPath, _CheckPathStatus($sSavedGamesPath))
    _AddLVItem3Col($hLV_Core, "Current LocalLow Path", $sLocalLowPath, _CheckPathStatus($sLocalLowPath))
    _AddBlankRow3Col($hLV_Core)
    _AddSectionHeader3Col($hLV_Core, ">>> ADVANCED SYSTEM PATHS <<<")
    _AddLVItem3Col($hLV_Core, "Username", EnvGet("USERNAME"), "N/A")
    _AddLVItem3Col($hLV_Core, "UserProfile", EnvGet("USERPROFILE"), _CheckPathStatus(EnvGet("USERPROFILE")))
    _AddLVItem3Col($hLV_Core, "Public Folder", EnvGet("PUBLIC"), _CheckPathStatus(EnvGet("PUBLIC")))
    _AddLVItem3Col($hLV_Core, "APPDATA", EnvGet("APPDATA"), _CheckPathStatus(EnvGet("APPDATA")))
    _AddLVItem3Col($hLV_Core, "LOCALAPPDATA", EnvGet("LOCALAPPDATA"), _CheckPathStatus(EnvGet("LOCALAPPDATA")))
    _AddLVItem3Col($hLV_Core, "Common AppData", $sCommonAppData, _CheckPathStatus($sCommonAppData))
    _SetColumnWidths3Col($hLV_Core, 240, 360, 130)

    ; VIEW 2: Environment
    Local $hLV_Env = GUICtrlCreateListView("Variable Name|Mapped System Path|Local Drive Status", 20, 102, 740, 385, BitOR($LVS_REPORT, $LVS_SINGLESEL))
    _ApplyListViewTheme($hLV_Env)
    GUICtrlSetState($hLV_Env, $GUI_HIDE)
    _AddSectionHeader3Col($hLV_Env, ">>> USER ENVIRONMENT PATHS <<<")
    _AddLVItem3Col($hLV_Env, "%APPDATA%", EnvGet("APPDATA"), _CheckPathStatus(EnvGet("APPDATA")))
    _AddLVItem3Col($hLV_Env, "%LOCALAPPDATA%", EnvGet("LOCALAPPDATA"), _CheckPathStatus(EnvGet("LOCALAPPDATA")))
    _AddLVItem3Col($hLV_Env, "%USERPROFILE%", EnvGet("USERPROFILE"), _CheckPathStatus(EnvGet("USERPROFILE")))
    _AddLVItem3Col($hLV_Env, "%HOMEPATH%", EnvGet("HOMEPATH"), _CheckPathStatus(EnvGet("HOMEDRIVE") & EnvGet("HOMEPATH")))
    _AddLVItem3Col($hLV_Env, "%HOMEDRIVE%", EnvGet("HOMEDRIVE"), _CheckPathStatus(EnvGet("HOMEDRIVE") & "\"))
    _AddLVItem3Col($hLV_Env, "%TEMP%", EnvGet("TEMP"), _CheckPathStatus(EnvGet("TEMP")))
    _AddLVItem3Col($hLV_Env, "%TMP%", EnvGet("TMP"), _CheckPathStatus(EnvGet("TMP")))
    _AddLVItem3Col($hLV_Env, "Desktop", EnvGet("USERPROFILE") & "\Desktop", _CheckPathStatus(EnvGet("USERPROFILE") & "\Desktop"))
    _AddLVItem3Col($hLV_Env, "Documents", EnvGet("USERPROFILE") & "\Documents", _CheckPathStatus(EnvGet("USERPROFILE") & "\Documents"))
    _AddLVItem3Col($hLV_Env, "Downloads", EnvGet("USERPROFILE") & "\Downloads", _CheckPathStatus(EnvGet("USERPROFILE") & "\Downloads"))
    _AddBlankRow3Col($hLV_Env)
    _AddSectionHeader3Col($hLV_Env, ">>> SYSTEM WIDE PATHS <<<")
    _AddLVItem3Col($hLV_Env, "%WINDIR%", EnvGet("WINDIR"), _CheckPathStatus(EnvGet("WINDIR")))
    _AddLVItem3Col($hLV_Env, "%SYSTEMROOT%", EnvGet("SYSTEMROOT"), _CheckPathStatus(EnvGet("SYSTEMROOT")))
    _AddLVItem3Col($hLV_Env, "%PROGRAMFILES%", EnvGet("PROGRAMFILES"), _CheckPathStatus(EnvGet("PROGRAMFILES")))
    _AddLVItem3Col($hLV_Env, "%PROGRAMFILES(X86)%", EnvGet("PROGRAMFILES(X86)"), _CheckPathStatus(EnvGet("PROGRAMFILES(X86)")))
    _AddLVItem3Col($hLV_Env, "%COMMONPROGRAMFILES%", EnvGet("COMMONPROGRAMFILES"), _CheckPathStatus(EnvGet("COMMONPROGRAMFILES")))
    _AddLVItem3Col($hLV_Env, "%SYSTEMDRIVE%", EnvGet("SYSTEMDRIVE"), _CheckPathStatus(EnvGet("SYSTEMDRIVE") & "\"))
    _AddLVItem3Col($hLV_Env, "%ALLUSERSPROFILE%", EnvGet("ALLUSERSPROFILE"), _CheckPathStatus(EnvGet("ALLUSERSPROFILE")))
    _SetColumnWidths3Col($hLV_Env, 240, 360, 130)

    ; VIEW 3: Registry Shell Folders
    Local $hLV_Reg = GUICtrlCreateListView("Registry Key / Category|Value Data Path|Local Drive Status", 20, 102, 740, 385, BitOR($LVS_REPORT, $LVS_SINGLESEL))
    _ApplyListViewTheme($hLV_Reg)
    GUICtrlSetState($hLV_Reg, $GUI_HIDE)
    _AddSectionHeader3Col($hLV_Reg, ">>> HKCU USER SHELL FOLDERS <<<")
    _PopulateRegistryLV3Col($hLV_Reg, "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders")
    _AddBlankRow3Col($hLV_Reg)
    _AddSectionHeader3Col($hLV_Reg, ">>> HKLM SYSTEM SHELL FOLDERS <<<")
    _PopulateRegistryLV3Col($hLV_Reg, "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders")
    _AddBlankRow3Col($hLV_Reg)
    _AddSectionHeader3Col($hLV_Reg, ">>> HKLM WOW6432NODE SHELL FOLDERS <<<")
    _PopulateRegistryLV3Col($hLV_Reg, "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders")
    _SetColumnWidths3Col($hLV_Reg, 250, 350, 130)

    ; Array of ListViews for Batch Repair Function
    Local $aLVList[3] = [$hLV_Core, $hLV_Env, $hLV_Reg]

    ; Manual Action Controls
    Local $hBtnRepairAll = GUICtrlCreateButton("Repair All Missing Local Paths", 20, 500, 220, 34)
    GUICtrlSetFont($hBtnRepairAll, 9, 700, 0, "Segoe UI")
    GUICtrlSetBkColor($hBtnRepairAll, 0x0284C7)
    GUICtrlSetColor($hBtnRepairAll, 0xFFFFFF)

    Local $hBtnClose = GUICtrlCreateButton("Close Status", 620, 500, 140, 34)
    GUICtrlSetFont($hBtnClose, 9, 700, 0, "Segoe UI")
    GUICtrlSetBkColor($hBtnClose, 0x2563EB)
    GUICtrlSetColor($hBtnClose, 0xFFFFFF)

    GUISetState(@SW_SHOW, $hDiagGUI)

    While 1
        Local $nDiagMsg = GUIGetMsg()
        Switch $nDiagMsg
            Case $GUI_EVENT_CLOSE, $hBtnClose
                ExitLoop
            Case $hBtnRepairAll
                _RepairAllMissingPaths($aLVList)
            Case $hTabBtn1
                _SwitchTab($hLV_Core, $hLV_Env, $hLV_Reg, $hTabBtn1, $hTabBtn2, $hTabBtn3)
            Case $hTabBtn2
                _SwitchTab($hLV_Env, $hLV_Core, $hLV_Reg, $hTabBtn2, $hTabBtn1, $hTabBtn3)
            Case $hTabBtn3
                _SwitchTab($hLV_Reg, $hLV_Core, $hLV_Env, $hTabBtn3, $hTabBtn1, $hTabBtn2)
        EndSwitch
    WEnd

    GUIDelete($hDiagGUI)
EndFunc

; --- Downloader Core Functions ---
Func _FetchSFPackages()
    GUICtrlSetData($idStatus, "Status: Fetching package list...")
    Local $bData = InetRead($sSFURL, 1)
    If @error Then
        GUICtrlSetData($idStatus, "Status: Error - SourceForge connection failed.")
        Return
    EndIf
    Local $sHtml = BinaryToString($bData, 4)
    Local $aMatches = StringRegExp($sHtml, '(?i)title="([^"]+\.exe)"', 3)
    
    If IsArray($aMatches) Then
        Local $sComboList = ""
        Local $oDict = ObjCreate("Scripting.Dictionary")
        For $i = 0 To UBound($aMatches) - 1
            Local $sFile = StringReplace($aMatches[$i], "Click to download ", "")
            $sFile = StringStripWS($sFile, 3)
            If Not $oDict.Exists($sFile) Then
                $oDict.Add($sFile, 1)
                $sComboList &= $sFile & "|"
            EndIf
        Next
        $sComboList = StringTrimRight($sComboList, 1)
        GUICtrlSetData($idPackage, $sComboList, StringSplit($sComboList, "|")[1])
        GUICtrlSetData($idStatus, "Status: Ready - Sync complete.")
    Else
        GUICtrlSetData($idStatus, "Status: No EXE files found on server.")
    EndIf
EndFunc

Func _StartDownloadProcess()
    Local $sPackage = GUICtrlRead($idPackage)
    Local $sDest = GUICtrlRead($idPathInput)
    If $sPackage = "" Then
        MsgBox($MB_ICONWARNING, "Selection Required", "Please select a package.")
        Return
    EndIf
    
    If StringRight($sDest, 1) <> "\" Then $sDest &= "\"
    Local $sSavePath = $sDest & $sPackage
    Local $sTempPath = $sDest & "temp_download.exe"

    If FileExists($sSavePath) And FileGetSize($sSavePath) > 5000 Then
        Local $sAction = _CustomChoicePopup($sPackage)
        If $sAction = "Run" Then
            GUICtrlSetData($idStatus, "Status: Running local package...")
            GUICtrlSetData($idProgress, 100)
            ShellExecute($sSavePath, "", $sDest)
            Return
        ElseIf $sAction = "Delete" Then
            FileDelete($sSavePath)
            GUICtrlSetData($idStatus, "Status: Local file deleted.")
            GUICtrlSetData($idProgress, 0)
            Return 
        Else 
            Return
        EndIf
    EndIf

    Local $iConfirm = MsgBox($MB_YESNO + $MB_ICONINFORMATION, "Pre-Installation Advisory", _
        "Please read the information about Ajay Prefix Pro before proceeding with the download." & @CRLF & @CRLF & _
        "Would you like to begin downloading " & $sPackage & "?")
    If $iConfirm <> 6 Then Return

    If FileExists($sTempPath) Then FileDelete($sTempPath)
    
    Local $sUrl = $sSFDownloadBase & $sPackage & "/download"
    GUICtrlSetState($idBtnDownload, $GUI_DISABLE)
    GUICtrlSetData($idStatus, "Status: Downloading " & $sPackage & "...")
    
    Local $hDownload = InetGet($sUrl, $sTempPath, 1, 1)
    Do
        Local $aData = InetGetInfo($hDownload)
        If $aData[1] > 0 Then GUICtrlSetData($idProgress, Int(($aData[0] / $aData[1]) * 100))
        Sleep(100)
    Until InetGetInfo($hDownload, 2)
    InetClose($hDownload)
    
    If FileGetSize($sTempPath) > 5000 Then
        FileMove($sTempPath, $sSavePath, $FC_OVERWRITE)
        GUICtrlSetData($idStatus, "Status: Deploying package installer...")
        ShellExecute($sSavePath, "", $sDest)
    Else
        GUICtrlSetData($idStatus, "Status: Error - Download failed.")
        If FileExists($sTempPath) Then FileDelete($sTempPath)
    EndIf
    
    GUICtrlSetState($idBtnDownload, $GUI_ENABLE)
EndFunc

Func _CustomChoicePopup($sFileName)
    Local $sHeader = "Already downloaded:"
    Local $sText = $sHeader & @CRLF & $sFileName

    Local $iLine1Len = StringLen($sHeader)
    Local $iLine2Len = StringLen($sFileName)
    Local $iMaxChars = ($iLine1Len > $iLine2Len) ? $iLine1Len : $iLine2Len
    
    Local $iMeasuredWidth = Int($iMaxChars * 9.5) + 40
    Local $iMinGuiWidth = 310
    Local $iGuiWidth = ($iMeasuredWidth > $iMinGuiWidth) ? $iMeasuredWidth : $iMinGuiWidth
    
    Local $iLabelWidth = $iGuiWidth - 40
    Local $iGuiHeight = 150
    
    Local $hPopup = GUICreate("File Already Exists", $iGuiWidth, $iGuiHeight, -1, -1, $DS_MODALFRAME, $WS_EX_TOPMOST, $hGUI)
    GUISetBkColor($CLR_BG_MAIN, $hPopup)
    
    Local $idLabel = GUICtrlCreateLabel($sText, 20, 15, $iLabelWidth, 55)
    GUICtrlSetFont($idLabel, 11, 400, 0, "Segoe UI")
    GUICtrlSetColor($idLabel, $CLR_TXT_GENERAL)
    GUICtrlSetBkColor($idLabel, $CLR_BG_MAIN)
    
    Local $iBtnW = 80
    Local $iBtnGap = 15
    Local $iTotalBtnW = ($iBtnW * 3) + ($iBtnGap * 2)
    Local $iStartXP = Int(($iGuiWidth - $iTotalBtnW) / 2)
    Local $iBtnY = 90
    
    Local $idRun = GUICtrlCreateButton("Run", $iStartXP, $iBtnY, $iBtnW, 35)
    GUICtrlSetFont($idRun, 11, 600, 0, "Segoe UI")
    GUICtrlSetBkColor($idRun, $CLR_BG_BTN_MAIN)
    GUICtrlSetColor($idRun, $CLR_TXT_BTN_MAIN)

    Local $idDelete = GUICtrlCreateButton("Delete", $iStartXP + $iBtnW + $iBtnGap, $iBtnY, $iBtnW, 35)
    GUICtrlSetFont($idDelete, 11, 600, 0, "Segoe UI")
    GUICtrlSetBkColor($idDelete, $CLR_BG_BTN_SUB)
    GUICtrlSetColor($idDelete, $CLR_TXT_BTN_SUB)

    Local $idCancel = GUICtrlCreateButton("Cancel", $iStartXP + ($iBtnW + $iBtnGap) * 2, $iBtnY, $iBtnW, 35)
    GUICtrlSetFont($idCancel, 11, 600, 0, "Segoe UI")
    GUICtrlSetBkColor($idCancel, $CLR_BG_BTN_SUB)
    GUICtrlSetColor($idCancel, $CLR_TXT_BTN_SUB)
    
    GUISetState(@SW_SHOW, $hPopup)
    Local $sResult = "Cancel"
    
    While 1
        Local $nMsg = GUIGetMsg()
        Select
            Case $nMsg = $GUI_EVENT_CLOSE Or $nMsg = $idCancel
                $sResult = "Cancel"
                ExitLoop
            Case $nMsg = $idRun
                $sResult = "Run"
                ExitLoop
            Case $nMsg = $idDelete
                $sResult = "Delete"
                ExitLoop
        EndSelect
    WEnd
    
    GUIDelete($hPopup)
    Return $sResult
EndFunc

; --- ListView & UI Helpers (3 Columns) ---
Func _SetColumnWidths3Col($hLV, $iCol1Width, $iCol2Width, $iCol3Width)
    _GUICtrlListView_SetColumnWidth($hLV, 0, $iCol1Width)
    _GUICtrlListView_SetColumnWidth($hLV, 1, $iCol2Width)
    _GUICtrlListView_SetColumnWidth($hLV, 2, $iCol3Width)
EndFunc

Func _AddSectionHeader3Col($hListView, $sHeaderTitle)
    GUICtrlCreateListViewItem($sHeaderTitle & "|=========================================================|=======", $hListView)
EndFunc

Func _AddBlankRow3Col($hListView)
    GUICtrlCreateListViewItem(" | | ", $hListView)
EndFunc

Func _StyleTabButton($hBtn, $bActive)
    GUICtrlSetFont($hBtn, 9, 700, 0, "Segoe UI")
    If $bActive Then
        GUICtrlSetBkColor($hBtn, 0x2563EB)
        GUICtrlSetColor($hBtn, 0xFFFFFF)
    Else
        GUICtrlSetBkColor($hBtn, 0x1E293B)
        GUICtrlSetColor($hBtn, 0x94A3B8)
    EndIf
EndFunc

Func _SwitchTab($hShowLV, $hHideLV1, $hHideLV2, $hActiveBtn, $hInactBtn1, $hInactBtn2)
    GUICtrlSetState($hHideLV1, $GUI_HIDE)
    GUICtrlSetState($hHideLV2, $GUI_HIDE)
    GUICtrlSetState($hShowLV, $GUI_SHOW)
    
    _StyleTabButton($hActiveBtn, True)
    _StyleTabButton($hInactBtn1, False)
    _StyleTabButton($hInactBtn2, False)
EndFunc

Func _ApplyListViewTheme($hLV)
    GUICtrlSetBkColor($hLV, 0x1E293B)
    GUICtrlSetColor($hLV, 0xF8FAFC)
    GUICtrlSetFont($hLV, 9, 600, 0, "Segoe UI")
EndFunc

Func _AddLVItem3Col($hListView, $sCol1, $sCol2, $sCol3)
    GUICtrlCreateListViewItem($sCol1 & "|" & $sCol2 & "|" & $sCol3, $hListView)
EndFunc

Func _PopulateRegistryLV3Col($hListView, $sRegKey)
    Local $i = 1, $sValName, $sValData
    While 1
        $sValName = RegEnumVal($sRegKey, $i)
        If @error Then ExitLoop
        
        If StringInStr($sValName, "WineVistaPaths") Or StringInStr($sValName, "_Wine") Then
            $i += 1
            ContinueLoop
        EndIf
        
        $sValData = RegRead($sRegKey, $sValName)
        Local $sExistsStatus = "N/A"
        
        If StringLen($sValData) > 2 And (StringInStr($sValData, ":\") Or StringLeft($sValData, 1) == "\") Then
            $sExistsStatus = _CheckPathStatus($sValData)
        EndIf

        _AddLVItem3Col($hListView, $sValName, $sValData, $sExistsStatus)
        $i += 1
    WEnd
EndFunc

Func _ReadConfigValue($sFilePath, $sSearchPattern)
    Local $hFile = FileOpen($sFilePath, 0)
    If $hFile = -1 Then Return ""
    
    Local $sLine = "", $sResult = ""
    While 1
        $sLine = FileReadLine($hFile)
        If @error Then ExitLoop
        If StringInStr($sLine, $sSearchPattern) Then
            Local $aSplit = StringSplit($sLine, "=")
            If $aSplit[0] >= 2 Then $sResult = StringStripWS($aSplit[2], 3)
            ExitLoop
        EndIf
    WEnd
    FileClose($hFile)
    Return $sResult
EndFunc

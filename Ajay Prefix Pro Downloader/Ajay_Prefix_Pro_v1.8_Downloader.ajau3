#include <GUIConstantsEx.au3>
#include <ProgressConstants.au3>
#include <WindowsConstants.au3>
#include <MsgBoxConstants.au3>
#include <StaticConstants.au3>
#include <GuiEdit.au3>
#include <StaticConstants.au3>
; --- Theme and Style Settings ---
DllCall("UxTheme.dll", "int", "SetThemeAppProperties", "int", 0)

Global Const $CLR_BG_MAIN        = 0xF0F8FF
Global Const $CLR_BG_HEADER      = 0x2C3E50
Global Const $CLR_TXT_HEADER     = 0xFFFFFF
Global Const $CLR_BG_INFO        = 0xFFFAF0
Global Const $CLR_TXT_INFO        = 0x191970
Global Const $CLR_BG_BTN_MAIN    = 0x3498DB
Global Const $CLR_TXT_BTN_MAIN   = 0xFFFFFF
Global Const $CLR_BG_BTN_SUB     = 0xBDC3C7
Global Const $CLR_TXT_BTN_SUB     = 0x333333
Global Const $CLR_TXT_GENERAL    = 0x333333

; --- Smart Manual Definitions ---
If Not IsDeclared("DS_MODALFRAME") Then Global Const $DS_MODALFRAME = 0x80
If Not IsDeclared("WS_EX_TOPMOST") Then Global Const $WS_EX_TOPMOST = 0x00000008
If Not IsDeclared("ES_AUTOVSCROLL") Then Global Const $ES_AUTOVSCROLL = 0x0040
If Not IsDeclared("ES_MULTILINE") Then Global Const $ES_MULTILINE = 0x0004
If Not IsDeclared("ES_READONLY") Then Global Const $ES_READONLY = 0x0800
If Not IsDeclared("WS_VSCROLL") Then Global Const $WS_VSCROLL = 0x00200000
If Not IsDeclared("FC_OVERWRITE") Then Global Const $FC_OVERWRITE = 1

; --- Configuration ---
Local $sSFURL = "https://sourceforge.net/projects/ajay-prefix/files/v1.8_offline/"
Local $sSFDownloadBase = "https://sourceforge.net/projects/ajay-prefix/files/v1.8_offline/"
Local $sGitHubHome = "https://github.com/ajay9634/Ajay-prefix"

; --- GUI Setup ---
Local $hGUI = GUICreate("Ajay Prefix Pro v1.8 Downloader", 500, 480)
GUISetBkColor($CLR_BG_MAIN)

; Header
; Use BitOR to combine horizontal and vertical centering
Local $idHeader = GUICtrlCreateLabel("AJAY PREFIX PRO v1.8 DOWNLOADER", 0, 0, 500, 50, BitOR($SS_CENTER, $SS_CENTERIMAGE))

GUICtrlSetBkColor($idHeader, $CLR_BG_HEADER)
GUICtrlSetColor($idHeader, $CLR_TXT_HEADER)
GUICtrlSetFont($idHeader, 12, 800, 0, "Segoe UI")

; 1. Package Selection
Local $idPkgLabel = GUICtrlCreateLabel("Detected Remote Packages (SourceForge):", 20, 60, 460, 25)
GUICtrlSetFont($idPkgLabel, 12, 400)
Local $idPackage = GUICtrlCreateCombo("", 20, 85, 460, 30)
GUICtrlSetFont($idPackage, 12, 400)

; 2. Info Panel
Local $idGroupInfo = GUICtrlCreateGroup(" About Ajay Prefix Pro ", 20, 120, 460, 170)
GUICtrlSetFont($idGroupInfo, 12, 600)

Local $sDescription = "Ajay Prefix Pro is a comprehensive utility suite designed for Wine-based environments." & @CRLF & _
                      "It is fully compatible with mobile PC emulators such as Mobox WOW64, Winlator, Dark OS, MiceWine, Hangover, and GameHub (GameFusion)." & @CRLF & @CRLF & _
                      "Core Functionality: Game save redirection (\Ajay_prefix\save_data) + Start Menu customization + Universal game fixes." & @CRLF & @CRLF & _
                      "Redirected Core Folders: Documents, Saved Games and LocalLow." & @CRLF & _
                      "Redirected Advanced Folders: AppData, Common AppData and Profile." & @CRLF & @CRLF & _
                      "============================================" & @CRLF & _
                      "Installation Guide Choice Mode:" & @CRLF & @CRLF & _
                      "1. Only Start Menu: Choose this if you only want Start Menu dependencies. You cannot redirect game save paths, and all prefix-related tools will be unavailable." & @CRLF & _
                      "2. Only Prefix: Choose this for full access to all prefix tools and save redirection. You cannot install dependencies in this mode." & @CRLF & _
                      "3. Both (Recommended): The full experience. Provides access to the complete Start Menu, all dependencies, and all prefix tools." & @CRLF & @CRLF & _
                      "Important: If you were using an older Ajay Prefix, after installing the latest Ajay Prefix v1.8, you must rename the 'xuser' folder to 'Ajay'. This is located in: Ajay_prefix\save_data\users\" & @CRLF & @CRLF & _
                      "============================================" & @CRLF & _
                      "Key Features:" & @CRLF & _
                      "- Auto-Backup: Creates a default registry backup at C:\AJAY_PREFIX_PRO\Backup\." & @CRLF & _
                      "- Performance Tweaks: Includes WineD3D, DXVK, VKD3D, and specialized registry optimizations." & @CRLF & _
                      "- Essential Runtimes: Pre-packed with VC Redist (All-in-One), XNA, PhysX, and Disk Tools." & @CRLF & _
                      "- Ajay Profile Hybridizer: Dynamically redirects %UserProfile% and %Public% paths." & @CRLF & @CRLF & _
                      "============================================" & @CRLF & _
                      "Which package should I run?" & @CRLF & @CRLF & _
"- Scripts Updater: Do not run this if you have not installed Ajay Prefix Pro. It updates all current Start Menu items to the latest version and provides new online Start Menu items not available in the offline version. Size: ~1.11 MB." & @CRLF & _
"- Offline Installer: This is the full version including the Prefix and all dependencies. Size: ~700 MB." & @CRLF & _
"- Only Prefix: This is a lite version containing only the Prefix without any dependencies. Size: ~30.72 MB." & @CRLF & _
"- Shortcut: This is a shortcut for the Ajay Prefix Pro launcher. If Ajay Prefix Pro is installed, you can use this app to launch your games in any PC emulation container. Size: ~1.02 MB."

                      "============================================"

Local $idInfoBox = GUICtrlCreateEdit($sDescription, 35, 140, 430, 140, BitOR($ES_READONLY, $WS_VSCROLL, $ES_MULTILINE, $ES_AUTOVSCROLL))
GUICtrlSetFont($idInfoBox, 12, 400)
GUICtrlSetBkColor($idInfoBox, $CLR_BG_INFO)
GUICtrlSetColor($idInfoBox, $CLR_TXT_INFO)
_GUICtrlEdit_LineScroll($idInfoBox, 0, -1000)
GUICtrlCreateGroup("", -99, -99, 1, 1)

; 3. Path
Local $idPathLabel = GUICtrlCreateLabel("Installation/Download Path:", 20, 300, 460, 25)
GUICtrlSetFont($idPathLabel, 12, 400)
Local $idPathInput = GUICtrlCreateInput(@ScriptDir, 20, 325, 340, 30)
GUICtrlSetFont($idPathInput, 12, 400)
Local $idBtnBrowse = GUICtrlCreateButton("Browse...", 370, 324, 110, 32)
GUICtrlSetFont($idBtnBrowse, 12, 600)
GUICtrlSetBkColor($idBtnBrowse, $CLR_BG_BTN_SUB)

; 4. Buttons
Local $idBtnDownload = GUICtrlCreateButton("Download and Run EXE", 120, 370, 260, 50)
GUICtrlSetFont($idBtnDownload, 12, 700)
GUICtrlSetBkColor($idBtnDownload, $CLR_BG_BTN_MAIN)
GUICtrlSetColor($idBtnDownload, $CLR_TXT_BTN_MAIN)

Local $idBtnGitHub = GUICtrlCreateButton("Wiki and Documentation)", 120, 430, 260, 35)
GUICtrlSetFont($idBtnGitHub, 12, 600)
GUICtrlSetBkColor($idBtnGitHub, $CLR_BG_BTN_SUB)

; 5. Progress
Local $idProgress = GUICtrlCreateProgress(20, 470, 460, 10)
Local $idStatus = GUICtrlCreateLabel("Status: Syncing with SourceForge...", 20, 485, 460, 20)
GUICtrlSetFont($idStatus, 12, 400)

GUISetState(@SW_SHOW, $hGUI)

_FetchSFPackages()

While 1
    Switch GUIGetMsg()
        Case $GUI_EVENT_CLOSE
            Exit
        Case $idBtnBrowse
            Local $sSelectedDir = FileSelectFolder("Select Destination Directory", "", 1 + 2, @ScriptDir)
            If Not @error Then GUICtrlSetData($idPathInput, $sSelectedDir)
        Case $idBtnGitHub
            ShellExecute($sGitHubHome)
        Case $idBtnDownload
            _StartDownloadProcess()
    EndSwitch
WEnd

Func _FetchSFPackages()
    GUICtrlSetData($idStatus, "Status: Fetching package list...")
    Local $bData = InetRead($sSFURL, 1)
    If @error Then
        GUICtrlSetData($idStatus, "Status: Error - SourceForge connection failed.")
        Return
    EndIf
    Local $sHtml = BinaryToString($bData, 4)
    Local $aMatches = StringRegExp($sHtml, '(?i)title="([^"]+\.exe)"', 3)
    
    If IsArray($aMatches) Then
        Local $sComboList = ""
        Local $oDict = ObjCreate("Scripting.Dictionary")
        For $i = 0 To UBound($aMatches) - 1
            Local $sFile = StringReplace($aMatches[$i], "Click to download ", "")
            $sFile = StringStripWS($sFile, 3)
            If Not $oDict.Exists($sFile) Then
                $oDict.Add($sFile, 1)
                $sComboList &= $sFile & "|"
            EndIf
        Next
        $sComboList = StringTrimRight($sComboList, 1)
        GUICtrlSetData($idPackage, $sComboList, StringSplit($sComboList, "|")[1])
        GUICtrlSetData($idStatus, "Status: Ready - Sync complete.")
    Else
        GUICtrlSetData($idStatus, "Status: No EXE files found on server.")
    EndIf
EndFunc

Func _StartDownloadProcess()
    Local $sPackage = GUICtrlRead($idPackage)
    Local $sDest = GUICtrlRead($idPathInput)
    If $sPackage = "" Then
        MsgBox($MB_ICONWARNING, "Selection Required", "Please select a package.")
        Return
    EndIf
    
    If StringRight($sDest, 1) <> "\" Then $sDest &= "\"
    Local $sSavePath = $sDest & $sPackage
    Local $sTempPath = $sDest & "temp_download.exe"

    If FileExists($sSavePath) And FileGetSize($sSavePath) > 5000 Then
        Local $sAction = _CustomChoicePopup($sPackage)
        If $sAction = "Run" Then
            GUICtrlSetData($idStatus, "Status: Running local package...")
            GUICtrlSetData($idProgress, 100)
            ShellExecute($sSavePath, "", $sDest)
            Return
        ElseIf $sAction = "Delete" Then
            FileDelete($sSavePath)
            GUICtrlSetData($idStatus, "Status: Local file deleted.")
            GUICtrlSetData($idProgress, 0)
            Return 
        Else 
            Return
        EndIf
    EndIf

    Local $iConfirm = MsgBox($MB_YESNO + $MB_ICONINFORMATION, "Pre-Installation Advisory", _
        "Please read the information about Ajay Prefix Pro before proceeding with the download." & @CRLF & @CRLF & _
"Would you like to begin downloading " & $sPackage & "?")
    If $iConfirm <> 6 Then Return

    
    If FileExists($sTempPath) Then FileDelete($sTempPath)
    
    Local $sUrl = $sSFDownloadBase & $sPackage & "/download"
    GUICtrlSetState($idBtnDownload, $GUI_DISABLE)
    GUICtrlSetData($idStatus, "Status: Downloading " & $sPackage & "...")
    
    Local $hDownload = InetGet($sUrl, $sTempPath, 1, 1)
    Do
        Local $aData = InetGetInfo($hDownload)
        If $aData[1] > 0 Then GUICtrlSetData($idProgress, Int(($aData[0] / $aData[1]) * 100))
        Sleep(100)
    Until InetGetInfo($hDownload, 2)
    InetClose($hDownload)
    
    If FileGetSize($sTempPath) > 5000 Then
        FileMove($sTempPath, $sSavePath, $FC_OVERWRITE)
        GUICtrlSetData($idStatus, "Status: Deploying package installer...")
        ShellExecute($sSavePath, "", $sDest)
    Else
        GUICtrlSetData($idStatus, "Status: Error - Download failed.")
        If FileExists($sTempPath) Then FileDelete($sTempPath)
    EndIf
    
    GUICtrlSetState($idBtnDownload, $GUI_ENABLE)
EndFunc

Func _CustomChoicePopup($sFileName)
    Local $hPopup = GUICreate("File Already Exists", 320, 150, -1, -1, $DS_MODALFRAME, $WS_EX_TOPMOST, $hGUI)
    GUISetBkColor($CLR_BG_MAIN, $hPopup)
    Local $idLabel = GUICtrlCreateLabel("Already downloaded:" & @CRLF & $sFileName, 20, 20, 280, 50)
    GUICtrlSetFont($idLabel, 12, 400)
    
    Local $idRun = GUICtrlCreateButton("Run", 20, 90, 80, 40)
    Local $idDelete = GUICtrlCreateButton("Delete", 120, 90, 80, 40)
    Local $idCancel = GUICtrlCreateButton("Cancel", 220, 90, 80, 40)
    
    GUISetState(@SW_SHOW, $hPopup)
    Local $sResult = "Cancel"
    
    While 1
        Local $nMsg = GUIGetMsg()
        Select
            Case $nMsg = $GUI_EVENT_CLOSE Or $nMsg = $idCancel
                $sResult = "Cancel"
                ExitLoop
            Case $nMsg = $idRun
                $sResult = "Run"
                ExitLoop
            Case $nMsg = $idDelete
                $sResult = "Delete"
                ExitLoop
        EndSelect
    WEnd
    
    GUIDelete($hPopup)
    Return $sResult
EndFunc

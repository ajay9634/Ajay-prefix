; 4. Buttons
Local $idBtnDownload = GUICtrlCreateButton("Download and Run EXE", 20, 370, 460, 45)
GUICtrlSetFont($idBtnDownload, 12, 700)
GUICtrlSetBkColor($idBtnDownload, $CLR_BG_BTN_MAIN)
GUICtrlSetColor($idBtnDownload, $CLR_TXT_BTN_MAIN)

Local $idBtnStatus = GUICtrlCreateButton("Ajay Prefix Pro Status", 20, 422, 225, 35)
GUICtrlSetFont($idBtnStatus, 10, 700)

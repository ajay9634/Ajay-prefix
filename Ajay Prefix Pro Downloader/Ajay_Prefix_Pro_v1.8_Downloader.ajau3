GUICtrlSetColor($idBtnStatus, 0xFFFFFF)

Local $idBtnGitHub = GUICtrlCreateButton("Wiki & Documentation", 255, 422, 225, 35)
GUICtrlSetFont($idBtnGitHub, 10, 600)
GUICtrlSetBkColor($idBtnGitHub, $CLR_BG_BTN_SUB)

; 5. Progress
Local $idProgress = GUICtrlCreateProgress(20, 467, 460, 10)
Local $idStatus = GUICtrlCreateLabel("Status: Syncing with SourceForge...", 20, 482, 460, 20)

#include <GUIConstantsEx.au3>
#include <ProgressConstants.au3>
#include <WindowsConstants.au3>
#include <MsgBoxConstants.au3>
#include <EditConstants.au3>

; --- Configuration ---
Local $sSFURL = "https://sourceforge.net/projects/ajay-prefix/files/v1.7.1_offline/"
Local $sSFDownloadBase = "https://sourceforge.net/projects/ajay-prefix/files/v1.7.1_offline/"
Local $sGitHubHome = "https://github.com/ajay9634/Ajay-prefix"

; --- GUI Setup ---
Local $hGUI = GUICreate("Ajay Prefix Pro v1.7.1 Downloader", 470, 420)

; 1. Package Selection Section
GUICtrlCreateLabel("Detected Remote Packages (SourceForge):", 20, 20, 250, 20)
Local $idPackage = GUICtrlCreateCombo("", 20, 40, 430, 20)

; 2. What is Ajay Prefix? (Information Panel with Internal Scrollbar)
GUICtrlCreateGroup("What is Ajay Prefix Pro?", 20, 75, 430, 140)

; README content - Exact text from source
Local $sDescription = "Ajay Prefix Pro is a comprehensive utility suite designed for Wine-based environments." & @CRLF & _
                      "It is fully compatible with mobile PC emulators such as Mobox WOW64, Winlator, Dark OS, MiceWine, Hangover, and GameHub (GameFusion)." & @CRLF & @CRLF & _
                      "Core Functionality: Game save redirection (\Ajay_prefix\save_data) + Start Menu customization + Universal game fixes." & @CRLF & @CRLF & _
                      "Redirected Folders: AppData, Documents, and Saved Games." & @CRLF & @CRLF & _
                      "Installation Guide Choice Mode:" & @CRLF & _
                      "1. Start Menu Only: Choose this if you only want Start Menu dependencies. You cannot redirect game save paths, and all prefix-related tools will be unavailable." & @CRLF & _
                      "2. Prefix Only: Choose this for full access to all prefix tools and save redirection. You cannot install dependencies in this mode." & @CRLF & _
                      "3. Both (Recommended): The full experience. Provides access to the complete Start Menu, all dependencies, and all prefix tools." & @CRLF & @CRLF & _
                      "Important: If you were using an older Ajay Prefix, after installing the latest Ajay Prefix v1.7.1, you must rename the 'xuser' folder to 'Ajay'. This is located in: Ajay_prefix\save_data\users\" & @CRLF & @CRLF & _
                      "Key Features:" & @CRLF & _
                      "- Auto-Backup: Creates a default registry backup at C:\AJAY_PREFIX_PRO\Backup\." & @CRLF & _
                      "- Performance Tweaks: Includes WineD3D, DXVK, VKD3D, and specialized registry optimizations." & @CRLF & _
                      "- Essential Runtimes: Pre-packed with VC Redist (All-in-One), XNA, PhysX, and Disk Tools." & @CRLF & _
                      "- Ajay Profile Hybridizer: Dynamically redirects %UserProfile% and %Public% paths."

Local $idInfoBox = GUICtrlCreateEdit($sDescription, 32, 95, 405, 110, BitOR($ES_READONLY, $WS_VSCROLL, $ES_MULTILINE, $ES_AUTOVSCROLL))
GUICtrlSetBkColor($idInfoBox, 0xF5F5F5) 
GUICtrlCreateGroup("", -99, -99, 1, 1)

; 3. Path & Installation Setup
GUICtrlCreateLabel("Installation/Download Path:", 20, 230, 200, 20)
Local $idPathInput = GUICtrlCreateInput(@ScriptDir, 20, 250, 330, 20)
Local $idBtnBrowse = GUICtrlCreateButton("Browse...", 360, 248, 90, 24)

; 4. Operational Buttons
Local $idBtnDownload = GUICtrlCreateButton("Download and Run Selected EXE", 105, 290, 260, 45)
Local $idBtnGitHub = GUICtrlCreateButton("Open GitHub (Wiki and Documentation)", 105, 345, 260, 30)

; 5. Status & Progress Tracking
Local $idProgress = GUICtrlCreateProgress(20, 390, 430, 12)
Local $idStatus = GUICtrlCreateLabel("Status: Syncing with SourceForge...", 20, 403, 430, 15)

GUISetState(@SW_SHOW, $hGUI)

; --- Initial Data Fetch ---
_FetchSFPackages()

; --- Main Event Loop ---
While 1
    Switch GUIGetMsg()
        Case $GUI_EVENT_CLOSE
            Exit
            
        Case $idBtnBrowse
            Local $sSelectedDir = FileSelectFolder("Select Destination Directory", "", 1 + 2, @ScriptDir)
            If Not @error Then GUICtrlSetData($idPathInput, $sSelectedDir)
            
        Case $idBtnGitHub
            ShellExecute($sGitHubHome)
            
        Case $idBtnDownload
            _StartDownloadProcess()
    EndSwitch
WEnd

; --- Core Network Functions ---
Func _FetchSFPackages()
    GUICtrlSetData($idStatus, "Status: Fetching package list...")
    Local $bData = InetRead($sSFURL, 1)
    If @error Then
        GUICtrlSetData($idStatus, "Status: Error - SourceForge connection failed.")
        Return
    EndIf
    Local $sHtml = BinaryToString($bData, 4)
    Local $aMatches = StringRegExp($sHtml, '(?i)title="([^"]+\.exe)"', 3)
    
    If IsArray($aMatches) Then
        Local $sComboList = ""
        Local $oDict = ObjCreate("Scripting.Dictionary")
        For $i = 0 To UBound($aMatches) - 1
            Local $sFile = StringReplace($aMatches[$i], "Click to download ", "")
            $sFile = StringStripWS($sFile, 3)
            If Not $oDict.Exists($sFile) Then
                $oDict.Add($sFile, 1)
                $sComboList &= $sFile & "|"
            EndIf
        Next
        $sComboList = StringTrimRight($sComboList, 1)
        GUICtrlSetData($idPackage, $sComboList, StringSplit($sComboList, "|")[1])
        GUICtrlSetData($idStatus, "Status: Ready - Sync complete.")
    Else
        GUICtrlSetData($idStatus, "Status: No EXE files found on server.")
    EndIf
EndFunc

Func _StartDownloadProcess()
    Local $sPackage = GUICtrlRead($idPackage)
    Local $sDest = GUICtrlRead($idPathInput)
    If $sPackage = "" Then
        MsgBox($MB_ICONWARNING, "Selection Required", "Please select a valid installation package from the list.")
        Return
    EndIf
    
    If StringRight($sDest, 1) <> "\" Then $sDest &= "\"
    Local $sSavePath = $sDest & $sPackage

    ; Check if the target file is already downloaded and valid
    If FileExists($sSavePath) And FileGetSize($sSavePath) > 5000 Then
        GUICtrlSetData($idStatus, "Status: Local package found. Running...")
        GUICtrlSetData($idProgress, 100)
        ShellExecute($sSavePath, "", $sDest)
        Return
    EndIf
    
    ; Updated advisory message block pulled directly from your exact README specifications
    Local $iConfirm = MsgBox($MB_YESNO + $MB_ICONINFORMATION, "Pre-Installation Advisory", _
        "Before proceeding, please understand this tool on the README:" & @CRLF & @CRLF & _
        "Core Functionality: Game save redirection (\Ajay_prefix\save_data) + Start Menu customization + Universal game fixes." & @CRLF & @CRLF & _
        "Redirected Folders: AppData, Documents, and Saved Games." & @CRLF & @CRLF & _
        "Do you want to begin downloading " & $sPackage & "?")
    If $iConfirm <> 6 Then Return 
    
    Local $sUrl = $sSFDownloadBase & $sPackage & "/download"
    
    GUICtrlSetState($idBtnDownload, $GUI_DISABLE)
    GUICtrlSetData($idStatus, "Status: Downloading " & $sPackage & "...")
    
    Local $hDownload = InetGet($sUrl, $sSavePath, 1, 1)
    Do
        Local $aData = InetGetInfo($hDownload)
        If $aData[1] > 0 Then GUICtrlSetData($idProgress, Int(($aData[0] / $aData[1]) * 100))
        Sleep(100)
    Until InetGetInfo($hDownload, 2)
    InetClose($hDownload)
    
    If FileGetSize($sSavePath) > 5000 Then
        GUICtrlSetData($idStatus, "Status: Deploying package installer...")
        ShellExecute($sSavePath, "", $sDest)
    Else
        GUICtrlSetData($idStatus, "Status: Error - Download failed.")
        FileDelete($sSavePath)
    EndIf
    GUICtrlSetState($idBtnDownload, $GUI_ENABLE)
EndFunc
